From f0a20081518359954366703bdb81aa3bfc2fa644 Mon Sep 17 00:00:00 2001
From: ryu <213640356+ryuhzk@users.noreply.github.com>
Date: Sat, 7 Nov 2026 13:50:06 +0800
Subject: [PATCH 1/2] Expose on_input_paste on TextInput and TextArea.

Lets apps stage clipboard files and images from the focused field
without dropping through to plain-text paste.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 crates/rune-kit/src/text_input.rs | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/crates/rune-kit/src/text_input.rs b/crates/rune-kit/src/text_input.rs
index eeb2821..46f29b3 100644
--- a/crates/rune-kit/src/text_input.rs
+++ b/crates/rune-kit/src/text_input.rs
@@ -96,6 +96,13 @@ impl EditActs {
     fn change<S: 'static>(&mut self, f: impl Fn(&mut S, &mut Tx) + 'static) {
         self.handlers.push(Box::new(move |e: El| e.on_input_change(f)));
     }
+    fn paste<S: 'static>(
+        &mut self,
+        f: impl Fn(&mut S, &rune::ClipboardContent, &mut Tx) -> bool + 'static,
+    ) {
+        self.handlers
+            .push(Box::new(move |e: El| e.on_input_paste(f)));
+    }
     fn visual(&mut self, f: impl FnOnce(El) -> El + 'static) {
         self.visual.push(Box::new(f));
     }
@@ -302,6 +309,14 @@ impl TextInput {
         self.copy_acts.press_tx(f);
         self
     }
+    /// See [`El::on_input_paste`](rune::El::on_input_paste).
+    pub fn on_input_paste<S: 'static>(
+        mut self,
+        f: impl Fn(&mut S, &rune::ClipboardContent, &mut Tx) -> bool + 'static,
+    ) -> Self {
+        self.edits.paste(f);
+        self
+    }
     rich_forwarders!();
 
     pub fn build(self, k: &Kit) -> El {
@@ -498,6 +513,15 @@ impl TextArea {
         self.edits.change(f);
         self
     }
+    /// See [`El::on_input_paste`](rune::El::on_input_paste). Requests every clipboard form
+    /// (files and images too) so the field can stage attachments on paste.
+    pub fn on_input_paste<S: 'static>(
+        mut self,
+        f: impl Fn(&mut S, &rune::ClipboardContent, &mut Tx) -> bool + 'static,
+    ) -> Self {
+        self.edits.paste(f);
+        self
+    }
     rich_forwarders!();
 
     pub fn build(self, k: &Kit) -> El {
-- 
