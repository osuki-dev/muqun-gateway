# Build output
/target

# The gateway's own secrets live in the config/state dirs, never the repo,
# but ignore any that get symlinked or copied in during local testing.
*.log
devices.json
pairing.json
push-tokens.json
config.json

# Local environment credentials; keep a shareable template trackable.
.env
.env.*
!.env.example

# Conventional SSH private-key filenames (public .pub files remain trackable).
id_rsa
id_ed25519

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Subagent-driven-development scratch workspace
.superpowers/
