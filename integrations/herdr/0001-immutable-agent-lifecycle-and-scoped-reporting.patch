index 0000000..8db511b
--- /dev/null
+++ b/src/pty/bound_lifecycle.rs
@@ -0,0 +1,195 @@
+//! Exact child ownership evidence, independent of readiness and pane lifetime.
+//! Retain at most 1024 unreaped/uncertain owners and 4096 exit tombstones.
+use std::collections::{HashMap, HashSet, VecDeque};
+use std::hash::{BuildHasher, Hasher};
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Observation {
+    Live,
+    Exited { receipt_id: String },
+    Unknown,
+}
+struct Registry {
+    epoch: String,
+    owned: HashMap<String, Observation>,
+    exited: VecDeque<(String, String)>,
+    max_owned: usize,
+    max_exited: usize,
+    operations: HashSet<String>,
+}
+fn opaque_id(prefix: &str) -> String {
+    let a = std::collections::hash_map::RandomState::new()
+        .build_hasher()
+        .finish();
+    let b = std::collections::hash_map::RandomState::new()
+        .build_hasher()
+        .finish();
+    format!("{prefix}_{a:016x}{b:016x}")
+}
+impl Registry {
+    fn new(max_owned: usize, max_exited: usize) -> Self {
+        Self {
+            epoch: opaque_id("owner"),
+            owned: HashMap::new(),
+            exited: VecDeque::new(),
+            max_owned,
+            max_exited,
+            operations: HashSet::new(),
+        }
+    }
+    fn reserve(&mut self, launch: &str) -> bool {
+        if self.owned.len() >= self.max_owned || self.owned.contains_key(launch) {
+            return false;
+        }
+        self.owned.insert(launch.into(), Observation::Unknown);
+        true
+    }
+    fn spawned(&mut self, launch: &str) {
+        if let Some(state) = self.owned.get_mut(launch) {
+            *state = Observation::Live;
+        }
+    }
+    fn invalidate(&mut self, launch: &str) {
+        if let Some(state) = self.owned.get_mut(launch) {
+            *state = Observation::Unknown;
+        }
+    }
+    fn waited(&mut self, launch: &str, success: bool) {
+        if !success {
+            self.invalidate(launch);
+            return;
+        }
+        if self.owned.remove(launch).is_none() {
+            return;
+        }
+        self.exited.push_back((launch.into(), opaque_id("exit")));
+        while self.exited.len() > self.max_exited {
+            self.exited.pop_front();
+        }
+    }
+    fn observe(&self, epoch: &str, launch: &str) -> Observation {
+        if epoch != self.epoch {
+            return Observation::Unknown;
+        }
+        if let Some(state) = self.owned.get(launch) {
+            return state.clone();
+        }
+        self.exited
+            .iter()
+            .find(|(id, _)| id == launch)
+            .map(|(_, receipt_id)| Observation::Exited {
+                receipt_id: receipt_id.clone(),
+            })
+            .unwrap_or(Observation::Unknown)
+    }
+}
+fn registry() -> &'static Mutex<Registry> {
+    static REGISTRY: OnceLock<Mutex<Registry>> = OnceLock::new();
+    REGISTRY.get_or_init(|| Mutex::new(Registry::new(1024, 4096)))
+}
+pub(crate) fn owner_epoch() -> String {
+    registry()
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .epoch
+        .clone()
+}
+/// Never mint a no-process receipt for a repeated operation that might have spawned.
+/// Operations are not evicted in this incarnation; capacity exhaustion is unknown.
+pub(crate) fn begin_operation(operation: &str) -> bool {
+    let mut registry = registry().lock().unwrap_or_else(|p| p.into_inner());
+    if registry.operations.len() >= 4096 {
+        return false;
+    }
+    registry.operations.insert(operation.into())
+}
+#[derive(Debug)]
+pub(crate) struct CapacityExceeded;
+impl std::fmt::Display for CapacityExceeded {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("bound lifecycle capacity exhausted before spawn")
+    }
+}
+impl std::error::Error for CapacityExceeded {}
+pub(crate) fn receipt_id() -> String {
+    opaque_id("refusal")
+}
+pub(crate) fn reserve(launch: &str) -> bool {
+    registry()
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .reserve(launch)
+}
+pub(crate) fn spawned(launch: &str) {
+    registry()
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .spawned(launch);
+}
+pub(crate) fn invalidate(launch: &str) {
+    registry()
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .invalidate(launch);
+}
+pub(crate) fn waited(launch: &str, success: bool) {
+    registry()
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .waited(launch, success);
+}
+pub(crate) fn observe(epoch: &str, launch: &str) -> Observation {
+    registry()
+        .lock()
+        .unwrap_or_else(|p| p.into_inner())
+        .observe(epoch, launch)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bound_lifecycle_requires_successful_wait_and_preserves_receipt() {
+        let mut r = Registry::new(2, 2);
+        let epoch = r.epoch.clone();
+        assert!(r.reserve("a"));
+        r.spawned("a");
+        assert_eq!(r.observe(&epoch, "a"), Observation::Live);
+        r.invalidate("a");
+        assert_eq!(r.observe(&epoch, "a"), Observation::Unknown);
+        r.waited("a", false);
+        assert_eq!(r.observe(&epoch, "a"), Observation::Unknown);
+        r.waited("a", true);
+        let proof = r.observe(&epoch, "a");
+        assert!(matches!(proof, Observation::Exited { .. }));
+        r.waited("a", true);
+        r.invalidate("a");
+        assert_eq!(r.observe(&epoch, "a"), proof);
+        assert_eq!(r.observe("new-epoch", "a"), Observation::Unknown);
+        assert_eq!(
+            r.observe(&epoch, "imported-without-waiter"),
+            Observation::Unknown
+        );
+    }
+    #[test]
+    fn bound_lifecycle_capacity_never_evicts_live_or_uncertain_owners() {
+        let mut r = Registry::new(1, 1);
+        let epoch = r.epoch.clone();
+        assert!(r.reserve("a"));
+        assert!(!r.reserve("b"));
+        r.spawned("a");
+        assert!(!r.reserve("b"));
+        r.waited("a", false);
+        assert!(!r.reserve("b"));
+        r.waited("a", true);
+        assert!(r.reserve("b"));
+        r.spawned("b");
+        r.waited("b", true);
+        assert_eq!(r.observe(&epoch, "a"), Observation::Unknown);
+        assert!(matches!(r.observe(&epoch, "b"), Observation::Exited { .. }));
+        let replacement = Registry::new(1, 1);
+        assert_ne!(replacement.epoch, epoch);
+        assert_eq!(replacement.observe(&epoch, "b"), Observation::Unknown);
+    }
+}
