+// The server's configured PATH selects the installed agent profile. A request
+// may name that exact native executable, never substitute a shell or wrapper.
+// This is a trusted local installation boundary, not signed binary attestation.
+pub(crate) fn bound_agent_kinds() -> Vec<String> {
+    std::env::var_os("PATH")
