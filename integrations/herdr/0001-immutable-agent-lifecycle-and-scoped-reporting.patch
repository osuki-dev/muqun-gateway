+//! Per-launch Codex reporting configuration; never changes user config or shell policy.
+use sha2::{Digest, Sha256};
+use std::io::Read;
+
+pub(super) fn config(
+    request: &crate::api::schema::BoundReportingMcp,
+    operation_id: &str,
+    context_file: &str,
+) -> Option<String> {
+    let path = std::path::Path::new(&request.executable);
+    let context = std::path::Path::new(context_file);
+    let expected = context
+        .parent()?
+        .join("reporting-binaries")
+        .join(format!("muqun-gateway-{}", request.sha256));
+    if path != expected || !std::fs::symlink_metadata(context).ok()?.is_file() {
+        return None;
+    }
+
+    if !path.is_absolute()
+        || request.executable.len() > 4096
+        || request.executable.chars().any(char::is_control)
+        || request.sha256.len() != 64
+        || !request
+            .sha256
+            .bytes()
+            .all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())
+        || path.canonicalize().ok()?.as_path() != path
+    {
+        return None;
+    }
+    let metadata = std::fs::symlink_metadata(path).ok()?;
+    if !metadata.is_file() || metadata.len() > 512 * 1024 * 1024 {
+        return None;
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::{MetadataExt, PermissionsExt};
+        if metadata.permissions().mode() & 0o077 != 0
+            || metadata.permissions().mode() & 0o100 == 0
+            || metadata.nlink() != 1
+        {
+            return None;
+        }
+    }
+    let mut options = std::fs::OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    let mut file = options.open(path).ok()?;
+    let actual = file.metadata().ok()?;
+    if !actual.is_file() || actual.len() != metadata.len() {
+        return None;
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if actual.dev() != metadata.dev() || actual.ino() != metadata.ino() {
+            return None;
+        }
+    }
+    let mut magic = [0; 4];
+    file.read_exact(&mut magic).ok()?;
+    if !matches!(
+        magic,
+        [0x7f, b'E', b'L', b'F']
+            | [0xfe, 0xed, 0xfa, 0xce]
+            | [0xce, 0xfa, 0xed, 0xfe]
+            | [0xfe, 0xed, 0xfa, 0xcf]
+            | [0xcf, 0xfa, 0xed, 0xfe]
+            | [0xca, 0xfe, 0xba, 0xbe]
+            | [0xbe, 0xba, 0xfe, 0xca]
+            | [0xca, 0xfe, 0xba, 0xbf]
+            | [0xbf, 0xba, 0xfe, 0xca]
+    ) {
+        return None;
+    }
+    let mut hash = Sha256::new();
+    hash.update(magic);
+    let mut bytes = [0; 65536];
+    let mut size = 4u64;
+    loop {
+        let n = file.read(&mut bytes).ok()?;
+        if n == 0 {
+            break;
+        }
+        size += n as u64;
+        if size > 512 * 1024 * 1024 {
+            return None;
+        }
+        hash.update(&bytes[..n]);
+    }
+    if format!("{:x}", hash.finalize()) != request.sha256 {
+        return None;
+    }
+    Some(config_value(&request.executable, operation_id))
+}
+
+fn config_value(executable: &str, operation_id: &str) -> String {
+    let suffix = format!("{:x}", Sha256::digest(operation_id.as_bytes()));
+    let server = serde_json::json!({
+        "command":executable,"args":["work","reporting-mcp"],
+        "env_vars":["MUQUN_WORK_CONTEXT_FILE"],
+        "enabled":true,"required":true,"experimental_environment":"local",
+        "enabled_tools":["context","submit_result","result_receipt"],
+        "default_tools_approval_mode":"prompt",
+        "tools":{
+            "context":{"approval_mode":"approve"},
+            "submit_result":{"approval_mode":"approve"},
+            "result_receipt":{"approval_mode":"approve"}
+        }
+    });
+    // TOML serializes the path as data, including quotes/backslashes. The
+    // operation namespace avoids merging another server's transport or env.
+    let table = toml::Value::try_from(server).expect("fixed reporting config is TOML");
+    format!("mcp_servers.muqun_reporting_{}={table}", &suffix[..16])
+}
