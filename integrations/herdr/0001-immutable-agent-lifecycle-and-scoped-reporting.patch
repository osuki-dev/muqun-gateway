+
+fn resolve_bound_agent_profile_in_path(
+    name: &str,
+    command: &str,
+    search: &std::ffi::OsStr,
+) -> Option<std::path::PathBuf> {
+    use std::io::Read;
+    let profile = std::env::split_paths(search)
+        .filter(|directory| directory.is_absolute())
+        .map(|directory| directory.join(name))
+        .find(|candidate| candidate.is_file())?
+        .canonicalize()
+        .ok()?;
+    let requested = if command == name {
+        profile.clone()
+    } else {
+        let requested = std::path::Path::new(command);
+        if !requested.is_absolute() {
+            return None;
+        }
+        requested.canonicalize().ok()?
+    };
+    if requested != profile {
+        return None;
+    }
+    let mut file = std::fs::File::open(&profile).ok()?;
+    let metadata = file.metadata().ok()?;
+    if !metadata.is_file() {
+        return None;
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o111 == 0 {
+            return None;
+        }
+    }
+    let mut magic = [0; 4];
+    file.read_exact(&mut magic).ok()?;
+    // Native ELF and Mach-O (including universal binaries). Script launchers
+    // need their own audited lifetime contract before strict mode supports them.
+    matches!(
+        magic,
+        [0x7f, b'E', b'L', b'F']
+            | [0xfe, 0xed, 0xfa, 0xce]
+            | [0xce, 0xfa, 0xed, 0xfe]
+            | [0xfe, 0xed, 0xfa, 0xcf]
+            | [0xcf, 0xfa, 0xed, 0xfe]
+            | [0xca, 0xfe, 0xba, 0xbe]
+            | [0xbe, 0xba, 0xfe, 0xca]
+            | [0xca, 0xfe, 0xba, 0xbf]
+            | [0xbf, 0xba, 0xfe, 0xca]
+    )
+    .then_some(profile)
