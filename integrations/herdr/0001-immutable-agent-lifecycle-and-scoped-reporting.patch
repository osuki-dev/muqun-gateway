+            bound_interrupt::complete(&params.operation_id, outcome.clone());
+            let _ = respond_to.send(encode_bound_interrupt(id.clone(), &params, outcome));
+        };
+        let runtime = self.state.workspaces.iter().find_map(|workspace| {
+            workspace
+                .tabs
+                .iter()
+                .flat_map(|tab| tab.layout.pane_ids())
+                .find_map(|pane_id| {
+                    let terminal_id = workspace.terminal_id(pane_id)?;
+                    let runtime = self.terminal_runtimes.get(terminal_id)?;
+                    (runtime.bound_launch_id() == Some(params.expected_launch_id.as_str()))
+                        .then_some(runtime)
+                })
