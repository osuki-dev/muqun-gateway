+++ b/src/pty/bound_interrupt.rs
@@ -0,0 +1,143 @@
+//! Epoch-local, bounded interruption admission. Never evict or redispatch an operation.
+use std::collections::HashMap;
+use std::hash::{BuildHasher, Hasher};
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Outcome {
+    Written { receipt_id: String },
+    Refused { code: String, message: String },
+}
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Admission {
+    Fresh,
+    Replay(Outcome),
+    Pending,
+    Conflict,
+    Full,
+}
+struct Record {
+    epoch: String,
+    launch: String,
+    outcome: Option<Outcome>,
+}
+struct Registry {
+    records: HashMap<String, Record>,
+    capacity: usize,
+}
+impl Registry {
+    fn reserve(&mut self, operation: &str, epoch: &str, launch: &str) -> Admission {
+        if let Some(record) = self.records.get(operation) {
+            if record.epoch != epoch || record.launch != launch {
+                return Admission::Conflict;
+            }
+            return record
+                .outcome
+                .clone()
+                .map_or(Admission::Pending, Admission::Replay);
+        }
+        if self.records.len() >= self.capacity {
+            return Admission::Full;
+        }
+        self.records.insert(
+            operation.into(),
+            Record {
+                epoch: epoch.into(),
+                launch: launch.into(),
+                outcome: None,
+            },
+        );
+        Admission::Fresh
+    }
+    fn complete(&mut self, operation: &str, outcome: Outcome) {
+        if let Some(record) = self.records.get_mut(operation) {
+            if record.outcome.is_none() {
+                record.outcome = Some(outcome);
+            }
+        }
+    }
+}
+fn registry() -> &'static Mutex<Registry> {
+    static REGISTRY: OnceLock<Mutex<Registry>> = OnceLock::new();
+    REGISTRY.get_or_init(|| {
+        Mutex::new(Registry {
+            records: HashMap::new(),
+            capacity: 4096,
+        })
+    })
+}
+pub(crate) fn reserve(operation: &str, epoch: &str, launch: &str) -> Admission {
+    registry().lock().map_or(Admission::Full, |mut registry| {
+        registry.reserve(operation, epoch, launch)
+    })
+}
+pub(crate) fn complete(operation: &str, outcome: Outcome) {
+    if let Ok(mut registry) = registry().lock() {
+        registry.complete(operation, outcome);
+    }
+}
+pub(crate) fn written() -> Outcome {
+    let a = std::collections::hash_map::RandomState::new()
+        .build_hasher()
+        .finish();
+    let b = std::collections::hash_map::RandomState::new()
+        .build_hasher()
+        .finish();
+    Outcome::Written {
+        receipt_id: format!("interrupt_{a:016x}{b:016x}"),
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bound_interrupt_replay_is_immutable_and_never_evicts() {
+        let mut registry = Registry {
+            records: HashMap::new(),
+            capacity: 1,
+        };
+        assert_eq!(registry.reserve("op", "epoch", "launch"), Admission::Fresh);
+        assert_eq!(
+            registry.reserve("op", "epoch", "launch"),
+            Admission::Pending
+        );
+        assert_eq!(
+            registry.reserve("op", "epoch", "other"),
+            Admission::Conflict
+        );
+        assert_eq!(
+            registry.reserve("op", "other", "launch"),
+            Admission::Conflict
+        );
+        let outcome = written();
+        registry.complete("op", outcome.clone());
+        registry.complete("op", written());
+        assert_eq!(
+            registry.reserve("op", "epoch", "launch"),
+            Admission::Replay(outcome)
+        );
+        assert_eq!(registry.reserve("new", "epoch", "launch"), Admission::Full);
+        assert!(
+            !registry.records.contains_key("new"),
+            "capacity refusal never admits a new operation"
+        );
+        assert_eq!(registry.records.len(), 1);
+    }
+    #[test]
+    fn bound_interrupt_refusals_are_cached() {
+        let mut registry = Registry {
+            records: HashMap::new(),
+            capacity: 1,
+        };
+        registry.reserve("op", "epoch", "launch");
+        let outcome = Outcome::Refused {
+            code: "instance_changed".into(),
+            message: "gone".into(),
+        };
+        registry.complete("op", outcome.clone());
+        assert_eq!(
+            registry.reserve("op", "epoch", "launch"),
+            Admission::Replay(outcome)
+        );
+    }
+}
