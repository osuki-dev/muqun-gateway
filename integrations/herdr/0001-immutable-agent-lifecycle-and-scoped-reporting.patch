--- /dev/null
+++ b/src/pty/bound_submission.rs
@@ -0,0 +1,350 @@
+//! Input ownership for a directly spawned agent process.
+//!
+//! The gate serializes observed ownership/readiness changes with each PTY write.
+//! It does not establish an agent-native approval protocol: callers must not
+//! advertise approval identity based on terminal screen detection.
+use std::io;
+use std::sync::{Arc, Mutex};
+
+#[derive(Clone, Debug)]
+pub(crate) struct BoundInputOwner {
+    launch_id: Arc<str>,
+    state: Arc<Mutex<OwnerState>>,
+}
+
+#[derive(Debug)]
+struct OwnerState {
+    revision: u64,
+    ready: bool,
+    invalidated: bool,
+}
+
+#[derive(Clone, Debug)]
+#[cfg_attr(
+    not(unix),
+    allow(
+        dead_code,
+        reason = "bound PTY writes are unsupported on this platform"
+    )
+)]
+pub(crate) struct BoundInputPermit {
+    owner: BoundInputOwner,
+    revision: u64,
+    written: Arc<Mutex<usize>>,
+}
+
+/// A control action depends on lifetime ownership, never prompt readiness.
+#[derive(Clone, Debug)]
+#[cfg_attr(
+    not(unix),
+    allow(
+        dead_code,
+        reason = "bound control writes are unavailable on this platform"
+    )
+)]
+pub(crate) struct BoundControlPermit {
+    owner: BoundInputOwner,
+}
+
+#[cfg_attr(
+    not(unix),
+    allow(
+        dead_code,
+        reason = "bound control writes are unavailable on this platform"
+    )
+)]
+impl BoundControlPermit {
+    /// Linearize cancellation of old prompt permits with one control syscall.
+    pub(crate) fn write(&self, write: impl FnOnce() -> io::Result<usize>) -> io::Result<()> {
+        let mut state = self.owner.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.invalidated {
+            return Err(refusal("agent launch exited or was replaced", 0));
+        }
+        state.revision = state.revision.saturating_add(1);
+        match write() {
+            Ok(1) => Ok(()),
+            Ok(0) => Err(refusal("interrupt wrote no bytes", 0)),
+            Ok(_) => Err(io::Error::other("unexpected interrupt write count")),
+            Err(error) => Err(error),
+        }
+    }
+}
+
+/// A refusal is definitely unwritten only when `bytes_written == 0`.
+/// Partial text followed by a revoked Enter must never be retried automatically.
+#[derive(Debug)]
+pub(crate) struct BoundInputError {
+    pub bytes_written: usize,
+    pub reason: &'static str,
+}
+
+impl std::fmt::Display for BoundInputError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{} ({} bytes written)", self.reason, self.bytes_written)
+    }
+}
+
+impl std::error::Error for BoundInputError {}
+
+impl BoundInputOwner {
+    pub(crate) fn control_permit(
+        &self,
+        expected_launch_id: &str,
+    ) -> io::Result<BoundControlPermit> {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if self.launch_id() != expected_launch_id || state.invalidated {
+            return Err(refusal("agent launch exited or was replaced", 0));
+        }
+        Ok(BoundControlPermit {
+            owner: self.clone(),
+        })
+    }
+    pub(crate) fn new(launch_id: String) -> Self {
+        Self {
+            launch_id: launch_id.into(),
+            state: Arc::new(Mutex::new(OwnerState {
+                revision: 0,
+                ready: false,
+                invalidated: false,
+            })),
+        }
+    }
+
+    pub(crate) fn launch_id(&self) -> &str {
+        &self.launch_id
+    }
+
+    /// Readiness changes revoke already queued submissions, even if the agent
+    /// becomes ready again before those submissions reach the writer.
+    pub(crate) fn set_ready(&self, ready: bool) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.ready != ready {
+            state.revision = state.revision.saturating_add(1);
+            state.ready = ready;
+        }
+    }
+
+    /// Permanent for this owner. A replacement process needs a new owner/id.
+    pub(crate) fn invalidate(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        state.invalidated = true;
+        state.ready = false;
+    }
+
+    pub(crate) fn permit(&self, expected_launch_id: &str) -> io::Result<BoundInputPermit> {
+        let state = self.state.lock().unwrap_or_else(|p| p.into_inner());
+        let reason = if expected_launch_id != self.launch_id() {
+            Some("agent launch identity changed")
+        } else if state.invalidated {
+            Some("agent launch exited or was replaced")
+        } else if !state.ready {
+            Some("agent is not ready for bound input")
+        } else {
+            None
+        };
+        if let Some(reason) = reason {
+            return Err(refusal(reason, 0));
+        }
+        Ok(BoundInputPermit {
+            owner: self.clone(),
+            revision: state.revision,
+            written: Arc::new(Mutex::new(0)),
+        })
+    }
+}
+
+#[cfg_attr(
+    not(unix),
+    allow(
+        dead_code,
+        reason = "bound PTY writes are unsupported on this platform"
+    )
+)]
+impl BoundInputPermit {
+    pub(crate) fn bytes_written(&self) -> usize {
+        *self.written.lock().unwrap_or_else(|p| p.into_inner())
+    }
+
+    /// Keep the owner lock held through the actual write, not only the queue
+    /// insertion. This is also used for a delayed Enter and each partial write.
+    pub(crate) fn write(&self, write: impl FnOnce() -> io::Result<usize>) -> io::Result<usize> {
+        let state = self.owner.state.lock().unwrap_or_else(|p| p.into_inner());
+        if state.invalidated || !state.ready || state.revision != self.revision {
+            return Err(refusal(
+                "agent input ownership or readiness changed",
+                self.bytes_written(),
+            ));
+        }
+        let result = write();
+        if let Ok(count) = result {
+            let mut written = self.written.lock().unwrap_or_else(|p| p.into_inner());
+            *written = written.saturating_add(count);
+        }
+        result
+    }
+
+    pub(crate) fn failure(&self, reason: &'static str) -> io::Error {
+        refusal(reason, self.bytes_written())
+    }
+}
+
+fn refusal(reason: &'static str, bytes_written: usize) -> io::Error {
+    io::Error::new(
+        io::ErrorKind::PermissionDenied,
+        BoundInputError {
+            bytes_written,
+            reason,
+        },
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn control_admission_ignores_readiness_but_not_lifetime_or_identity() {
+        let owner = BoundInputOwner::new("owned".into());
+        assert!(owner.control_permit("replacement").is_err());
+        let control = owner.control_permit("owned").unwrap();
+        control.write(|| Ok(1)).unwrap();
+        owner.invalidate();
+        assert!(owner.control_permit("owned").is_err());
+        assert!(control
+            .write(|| panic!("exit must fence the syscall"))
+            .is_err());
+    }
+
+    #[test]
+    fn control_syscall_and_exit_have_one_owner_lock_order() {
+        let owner = BoundInputOwner::new("owned".into());
+        let control = owner.control_permit("owned").unwrap();
+        let barrier = Arc::new(std::sync::Barrier::new(2));
+        let thread_barrier = barrier.clone();
+        let exit_owner = owner.clone();
+        let (tx, rx) = std::sync::mpsc::channel();
+        let exit = std::thread::spawn(move || {
+            thread_barrier.wait();
+            exit_owner.invalidate();
+            tx.send(()).unwrap();
+        });
+        control
+            .write(|| {
+                barrier.wait();
+                assert!(
+                    rx.try_recv().is_err(),
+                    "invalidation cannot pass active syscall"
+                );
+                Ok(1)
+            })
+            .unwrap();
+        exit.join().unwrap();
+        rx.recv().unwrap();
+        assert!(control
+            .write(|| panic!("no second syscall after exit"))
+            .is_err());
+    }
+
+    fn ready_owner() -> BoundInputOwner {
+        let owner = BoundInputOwner::new("launch-one".into());
+        owner.set_ready(true);
+        owner
+    }
+
+    fn written_count(error: io::Error) -> usize {
+        error
+            .get_ref()
+            .unwrap()
+            .downcast_ref::<BoundInputError>()
+            .unwrap()
+            .bytes_written
+    }
+
+    #[test]
+    fn a_reused_target_cannot_authorize_another_launch() {
+        let owner = ready_owner();
+        assert_eq!(written_count(owner.permit("launch-two").unwrap_err()), 0);
+    }
+
+    #[test]
+    fn exit_before_queue_drain_prevents_every_byte() {
+        let owner = ready_owner();
+        let permit = owner.permit("launch-one").unwrap();
+        owner.invalidate();
+        assert_eq!(
+            written_count(permit.write(|| panic!("must not write")).unwrap_err()),
+            0
+        );
+    }
+
+    #[test]
+    fn blocked_then_ready_does_not_revive_an_old_permit() {
+        let owner = ready_owner();
+        let permit = owner.permit("launch-one").unwrap();
+        owner.set_ready(false);
+        owner.set_ready(true);
+        assert_eq!(
+            written_count(permit.write(|| panic!("must not write")).unwrap_err()),
+            0
+        );
+        assert!(owner.permit("launch-one").is_ok());
+    }
+
+    #[test]
+    fn exit_after_text_suppresses_enter_and_reports_partial_delivery() {
+        let owner = ready_owner();
+        let permit = owner.permit("launch-one").unwrap();
+        permit.write(|| Ok(12)).unwrap();
+        owner.invalidate();
+        assert_eq!(
+            written_count(permit.write(|| panic!("Enter must not write")).unwrap_err()),
+            12
+        );
+    }
+
+    #[test]
+    fn invalidated_owner_cannot_be_reenabled() {
+        let owner = ready_owner();
+        owner.invalidate();
+        owner.set_ready(true);
+        assert_eq!(written_count(owner.permit("launch-one").unwrap_err()), 0);
+    }
+
+    #[test]
+    fn invalidation_serializes_with_the_actual_write() {
+        let owner = ready_owner();
+        let permit = owner.permit("launch-one").unwrap();
+        let writer_permit = permit.clone();
+        let (entered_tx, entered_rx) = std::sync::mpsc::channel();
+        let (release_tx, release_rx) = std::sync::mpsc::channel();
+        let writer = std::thread::spawn(move || {
+            writer_permit.write(|| {
+                entered_tx.send(()).unwrap();
+                release_rx.recv().unwrap();
+                Ok(3)
+            })
+        });
+        entered_rx.recv().unwrap();
+        // The writer holds the exact gate used by invalidation until the
+        // syscall finishes, so there is no check-then-write unlocked interval.
+        assert!(owner.state.try_lock().is_err());
+        release_tx.send(()).unwrap();
+        assert_eq!(writer.join().unwrap().unwrap(), 3);
+        owner.invalidate();
+        assert_eq!(
+            written_count(permit.write(|| panic!("later write refused")).unwrap_err()),
+            3
+        );
+    }
+
+    #[test]
+    fn a_partial_write_is_counted_and_would_block_is_not() {
+        let owner = ready_owner();
+        let permit = owner.permit("launch-one").unwrap();
+        permit.write(|| Ok(2)).unwrap();
+        assert!(permit
+            .write(|| Err(io::ErrorKind::WouldBlock.into()))
+            .is_err());
+        assert_eq!(permit.bytes_written(), 2);
+    }
+}
