+fn encode_bound_interrupt(
+    id: String,
+    params: &crate::api::schema::AgentInterruptBoundParams,
+    outcome: crate::pty::bound_interrupt::Outcome,
+) -> String {
+    match outcome {
+        crate::pty::bound_interrupt::Outcome::Written { receipt_id } => encode_success(
+            id,
+            ResponseResult::AgentInterruptedBound {
+                operation_id: params.operation_id.clone(),
+                launch_id: params.expected_launch_id.clone(),
+                owner_epoch: params.expected_owner_epoch.clone(),
+                receipt_id,
+                key: "Escape".into(),
+                bytes_written: 1,
+                input_disposition: "written".into(),
+            },
+        ),
+        crate::pty::bound_interrupt::Outcome::Refused { code, message } => {
+            encode_error(id, &code, message)
+        }
+    }
+}
+fn interrupt_error(error: &std::io::Error) -> crate::pty::bound_interrupt::Outcome {
+    let (code, message) = bound_input_error_parts(error);
+    crate::pty::bound_interrupt::Outcome::Refused {
+        code: code.into(),
+        message: message.into(),
+    }
+}
+fn bound_prompt_error(id: String, error: &std::io::Error) -> String {
+    let (code, message) = bound_input_error_parts(error);
+    encode_error(id, code, message)
+}
+fn bound_input_error_parts(error: &std::io::Error) -> (&'static str, &'static str) {
+    if let Some(detail) = error
+        .get_ref()
+        .and_then(|error| error.downcast_ref::<crate::pty::bound_submission::BoundInputError>())
+    {
+        if detail.bytes_written == 0 {
+            let code = if detail.reason.contains("identity") || detail.reason.contains("exited") {
+                "instance_changed"
+            } else {
+                "agent_not_ready"
+            };
+            return (code, "bound input was refused before writing");
+        }
+    }
+    (
+        "delivery_unconfirmed",
+        "bound input may have been partially written",
+    )
+}
