+fn bound_agent_kinds_in_path(path: &std::ffi::OsStr) -> Vec<String> {
+    crate::detect::Agent::ALL
+        .into_iter()
+        .filter_map(|kind| {
+            let executable = crate::detect::interactive_agent_executable(kind);
+            resolve_bound_agent_profile_in_path(executable, executable, path)
+                .map(|_| crate::detect::agent_label(kind).to_string())
+        })
